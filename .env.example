VITE_API_BASE_URL=https://api.30nezog.shop

# --- 로컬 개발 전용 (선택) ---
# OAuth 로그인 없이 화면을 바로 열고 싶을 때. .env.local 에 복사해서 사용.
# VITE_DEV_BYPASS_AUTH=true
# 배포 사이트에서 로그인 후 localStorage.getItem('accessToken') 값을 붙여넣으면 실제 API도 붙는다.
# 비워두면 더미 토큰이 들어가고, API 호출은 401이 나지만 화면 디자인은 확인 가능.
# VITE_DEV_ACCESS_TOKEN=
# VITE_DEV_LANGUAGE=KOREAN
